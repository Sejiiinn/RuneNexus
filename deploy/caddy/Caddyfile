{
	admin 127.0.0.1:2019
	email {$ACME_EMAIL}
}

{$API_HOST} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy api:8080 {
		health_uri /health/ready
		health_interval 30s
		health_timeout 3s
	}
}
