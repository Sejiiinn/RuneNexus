# DuckDNS에서 선점한 label과 이를 포함한 공개 API 호스트명
DUCKDNS_SUBDOMAIN=your-rune-nexus-api
API_HOST=your-rune-nexus-api.duckdns.org

# 정상 갱신 주기. 실패하면 30초 간격으로 재시도한다.
DUCKDNS_UPDATE_INTERVAL_SECONDS=300
DUCKDNS_RETRY_INTERVAL_SECONDS=30

# ACME 인증서 만료·계정 알림을 받을 주소
ACME_EMAIL=admin@example.com

# Google Identity Services Web OAuth Client ID
GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# 영속 인증 활성화용 AES-256 키(base64). 모든 인스턴스가 동일 키를 재시작 후에도 유지.
# 비어 있으면 기존 유한 세션 API만 사용 가능. 실제 키를 저장소에 커밋하지 않는다.
AUTH_SESSION_RECEIPT_KEY=

# 쉼표로 구분한 정확한 웹 origin 목록. 경로와 wildcard는 사용하지 않는다.
CORS_ALLOWED_ORIGINS=https://sejiiinn.github.io

# 인증 요청의 클라이언트별 token bucket 조정값
AUTH_RATE_LIMIT_WINDOW=1m
GOOGLE_AUTH_RATE_LIMIT=10
REFRESH_AUTH_RATE_LIMIT=30
LEGACY_TRANSFER_CREATE_RATE_LIMIT=3
LEGACY_TRANSFER_CONSUME_RATE_LIMIT=10
# 인증 endpoint마다 메모리에 보관할 최대 클라이언트 수
AUTH_RATE_LIMIT_MAX_CLIENTS=10000

# 계정 저장 writer와 PUT에 허용할 최소 클라이언트 호환 버전
MINIMUM_SAVE_CLIENT_COMPATIBILITY_VERSION=1

# 기존 카카오 인앱 브라우저 테스터 전용. 정식 배포 전 코드·DB와 함께 제거한다.
LEGACY_LOCAL_TRANSFER_ENABLED=true
LEGACY_TRANSFER_TTL=15m
